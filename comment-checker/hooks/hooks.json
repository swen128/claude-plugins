{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "command -v bun >/dev/null 2>&1 || exit 0; exec bun \"${CLAUDE_PLUGIN_ROOT}/scripts/check-comments.ts\""
          }
        ]
      }
    ]
  }
}
